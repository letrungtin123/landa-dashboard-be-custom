# LANDA dashboard — safe template committed to Git.
# Do not put database URLs, service keys, private network targets, or OAuth
# client secrets in any VITE_* variable: Vite exposes them to the browser.

# Required public API origin. Use same-origin when a reverse proxy exposes
# /api. For a path-scoped same-origin gateway, use same-origin:/admin so
# requests resolve to https://<current-host>/admin/api/... without CORS.
VITE_CUSTOM_API_URL=
# Optional dedicated HTTPS API origin for large course-asset uploads. This is
# still the authenticated LANDA API, never a Storage URL or a private address.
VITE_COURSE_ASSET_UPLOAD_ORIGIN=
VITE_PUBLIC_ORIGIN=auto
VITE_API_TIMEOUT_MS=30000
VITE_TOKEN_REFRESH_BUFFER_MS=300000

# Optional public browser settings. Client IDs are public identifiers only;
# never add a client secret to this file or any VITE_* variable.
VITE_OPENEDX_LMS_URL=
VITE_OPENEDX_CMS_URL=
VITE_OPENEDX_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_AUTHORITY=
VITE_KEYCLOAK_AUTHORITY=
VITE_KEYCLOAK_CLIENT_ID=

# Vite dev/preview server settings. Proxy targets are server-side only and
# intentionally blank so private IPs/domains never enter Git.
VITE_ALLOWED_HOSTS=
VITE_DEV_PORT=8080
VITE_PREVIEW_PORT=5274
PROXY_BACKEND_URL=
PROXY_OPENEDX_LMS_URL=
PROXY_OPENEDX_CMS_URL=
